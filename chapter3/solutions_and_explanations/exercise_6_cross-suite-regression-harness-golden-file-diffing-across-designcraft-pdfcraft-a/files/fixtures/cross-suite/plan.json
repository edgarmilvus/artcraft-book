{
  "fixtureId": "cross-suite",
  "tolerance": { "textDamerauLevenshtein": 0, "renderPixelLevenshtein": 0 },
  "steps": [
    { "cli": "designcraft", "command": "file.new", "params": { "preset": "Letter", "pages": 1 } },
    { "cli": "designcraft", "command": "frame.create", "params": { "rect": [72, 96, 540, 240], "content": "text", "text": "Cross Suite" } },
    { "cli": "designcraft", "command": "style.paragraph.apply", "params": { "name": "[Basic Paragraph]" } },
    { "cli": "designcraft", "command": "file.exportPdf", "params": { "path": "out.pdf", "standard": "a2b" } },
    { "cli": "pdfcraft",   "command": "doc_open", "params": { "path": "out.pdf" } },
    { "cli": "wordcraft",  "command": "new_document", "params": { "width": 612, "height": 792 } },
    { "cli": "wordcraft",  "command": "text.insert", "params": { "text": "Same fixture, three engines." } }
  ]
}
