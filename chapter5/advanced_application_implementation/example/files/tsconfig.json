{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/creativeforge/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "run_*.ts"
  ]
}
